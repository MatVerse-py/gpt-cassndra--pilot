{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matverse.local/schemas/audit-event.schema.json",
  "title": "CINAuditEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_id",
    "transaction_id",
    "audit_token_hash",
    "status",
    "gate",
    "reason",
    "issuer",
    "verification",
    "created_at",
    "schema_version",
    "previous_event_hash",
    "event_hash"
  ],
  "properties": {
    "audit_id": { "type": "string", "format": "uuid" },
    "transaction_id": { "type": "string", "format": "uuid" },
    "audit_token_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "type": "string", "enum": ["VALID", "INVALID", "EXPIRED", "REVOKED", "UNVERIFIED"] },
    "gate": { "type": "string", "enum": ["PASS", "HOLD", "BLOCK", "ESCALATE"] },
    "reason": { "type": "string", "minLength": 3, "maxLength": 128 },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "state_code", "agency_id"],
      "properties": {
        "country": { "type": "string", "const": "BR" },
        "state_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "agency_id": { "type": "string" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpf_format_valid", "issuer_trusted", "signature_valid", "source"],
      "properties": {
        "cpf_format_valid": { "type": "boolean" },
        "issuer_trusted": { "type": "boolean" },
        "signature_valid": { "type": "boolean" },
        "source": { "type": "string", "enum": ["sandbox", "official-connector-required", "official"] }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "schema_version": { "type": "string", "const": "audit-event.v1" },
    "previous_event_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "event_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
